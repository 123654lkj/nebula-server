# ===================== 星枢 Nebula 配置示例 =====================
# 复制为 .env 并填入真实值：cp .env.example .env
# ===============================================================

# 必填：百炼/DashScope API key（embedding + LLM 改写）
BAILIAN_API_KEY=sk-your-key-here

# LLM 模型（默认 qwen3.7-plus）
NEBULA_LLM_MODEL=qwen3.7-plus

# 服务监听（默认 0.0.0.0:26670）
NEBULA_HOST=0.0.0.0
NEBULA_PORT=26670

# 数据库路径（默认 <目录>/data/memory_vectors.db）
# NEBULA_DB_PATH=/data/memory_vectors.db

# 兼容任意 OpenAI 格式网关时覆盖：
# BAILIAN_BASE_URL=https://your-gateway/v1

# 本地知识库根目录（启用 readback 原文回读提示）
# NEBULA_VAULT_ROOT=/path/to/vault

# 自定义 CA 证书（自签 HTTPS 网关用）
# NEBULA_CA_PATH=/etc/ssl/certs/ca.pem
