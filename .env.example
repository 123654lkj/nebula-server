# ===================== 星枢 Nebula 完整部署配置 =====================
# cp .env.example .env  后填真实值
# =================================================================

# 必填：百炼/DashScope API key（embedding + LLM）
BAILIAN_API_KEY=sk-your-key-here

# 可选：OpenAI 兼容网关
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEBULA_LLM_MODEL=qwen3.7-plus

# 服务
NEBULA_HOST=0.0.0.0
NEBULA_PORT=26670
# NEBULA_DB_PATH=./data/memory_vectors.db

# 黑曜石 / Obsidian 笔记
# 本机默认用包内 vault/notes；Docker 可用 VAULT_HOST_PATH 挂载你的真实 vault
VAULT_ROOT=./vault/notes
# VAULT_HOST_PATH=./vault/notes
# VAULT_HOST_PATH=/path/to/your/obsidian/vault/notes
VAULT_SYNC_MAX_BYTES=120000
# 额外同步文件（可选，路径用系统 pathsep 分隔）
# NEBULA_EXTRA_SYNC_FILES=

# 同步目标（脚本用）
NEBULA_URL=http://127.0.0.1:26670

# —— 产品/企业（可选）——
# 鉴权：设置后除 /health /help 外需 Authorization: Bearer
# NEBULA_API_TOKEN=
# 租户：请求带 tenant_id 或头 X-Nebula-Tenant
# NEBULA_DEFAULT_TENANT=
# NEBULA_REQUIRE_TENANT=0
# 权威与回读（按客户知识库改，勿写死某实验室）
# NEBULA_PIN_REGEX=[A-Za-z0-9._-]{3,}\.md
# NEBULA_CANON_SUBSTR=vault:gateway/,vault:notes/01-,vault:notes/02-,notes/HOME.md,notes/PROJECT.md
# NEBULA_DEMOTE_SUBSTR=/04-,/05-
# NEBULA_READBACK_FMT=     # 空=只回 vault:路径；可写成: open {path}
