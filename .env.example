# ===================== 星枢 Nebula 完整部署配置 =====================
# cp .env.example .env  后填真实值
# =================================================================

# 必填：百炼/DashScope API key（embedding + LLM）
BAILIAN_API_KEY=sk-your-key-here

# 可选：OpenAI 兼容网关
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEBULA_LLM_MODEL=qwen3.7-plus

# 服务
NEBULA_HOST=0.0.0.0
NEBULA_PORT=26670
# NEBULA_DB_PATH=./data/memory_vectors.db

# 黑曜石 / Obsidian 笔记
# 本机默认用包内 vault/notes；Docker 可用 VAULT_HOST_PATH 挂载你的真实 vault
VAULT_ROOT=./vault/notes
# VAULT_HOST_PATH=./vault/notes
# VAULT_HOST_PATH=/path/to/your/obsidian/vault/notes
VAULT_SYNC_MAX_BYTES=120000
# 额外同步文件（可选，路径用系统 pathsep 分隔）
# NEBULA_EXTRA_SYNC_FILES=

# 同步目标（脚本用）
NEBULA_URL=http://127.0.0.1:26670
