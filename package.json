{
  "name": "nebula-server",
  "version": "1.0.0",
  "description": "星枢 Nebula 可部署记忆服务：HTTP API + Obsidian 同步 + multi-agent hooks/skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/123654lkj/nebula-server.git"
  },
  "homepage": "https://github.com/123654lkj/nebula-server#readme",
  "bugs": {
    "url": "https://github.com/123654lkj/nebula-server/issues"
  },
  "bin": {
    "nebula": "bin/nebula.js"
  },
  "scripts": {
    "setup": "node bin/nebula.js setup",
    "start": "node bin/nebula.js start",
    "sync": "node bin/nebula.js sync",
    "health": "node bin/nebula.js health",
    "score": "node bin/nebula.js score",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f nebula",
    "postinstall": "node bin/nebula.js doctor --quiet || true",
    "agents:install": "node bin/nebula.js agents-install",
    "agents:list": "bash agents/install-agents.sh --list || node bin/nebula.js agents-list"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nebula",
    "memory",
    "obsidian",
    "rag",
    "agent",
    "vector"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "scripts",
    "vault",
    "deploy",
    "docs",
    "docker-compose.yml",
    "Dockerfile",
    "requirements.txt",
    "install.sh",
    "start.sh",
    "*.py",
    "categories.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ]
}
