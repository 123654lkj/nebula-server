[Unit]
Description=星枢 (Nebula) 向量记忆系统
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nebula-engine
WorkingDirectory=/opt/nebula
Restart=always
RestartSec=3
Environment=NEBULA_DB_PATH=/opt/nebula/data/memory_vectors.db
Environment=NEBULA_BIND=0.0.0.0
Environment=NEBULA_PORT=26670
Environment=NEBULA_DOCS_DIR=/opt/nebula/docs
Environment=RUST_LOG=nebula_engine=info
EnvironmentFile=-/etc/nebula/embed.env
EnvironmentFile=-/etc/nebula/llm.env
MemoryAccounting=yes
MemoryHigh=150M
MemoryMax=200M
TasksMax=64

[Install]
WantedBy=multi-user.target
